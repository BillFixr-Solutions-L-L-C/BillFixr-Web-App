APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/billfixr.log

# Local temporary auth. If LOCAL_API_KEY is empty, auth is disabled for local demos.
LOCAL_API_KEY=
LOCAL_DEFAULT_ROLE=admin

# AI model access
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ON_VALIDATION_FAILURE=true

# Inbound email ingestion
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
EMAIL_LOOKBACK_DAYS=7

# Storage
STORAGE_DIR=.billfixr-data
CACHE_DIR=.billfixr-cache
DATABASE_PATH=.billfixr-data/billfixr.sqlite3
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.txt,.text,.md,.csv,.tsv,.json,.jsonl,.xml,.html,.htm,.eml,.docx,.xlsx

# Optional Fernet key for encrypted local object storage.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
MALWARE_SCAN_ENABLED=true
CLAMAV_ENABLED=false
CLAMSCAN_PATH=clamscan

# OCR
ENABLE_OCR=true
OCR_ENGINE=tesseract
PADDLE_OCR_TIMEOUT_SECONDS=20
TESSERACT_CMD=

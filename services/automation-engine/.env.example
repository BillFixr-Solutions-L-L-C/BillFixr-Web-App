# Copy to .env and fill in. Never commit .env.

# --- Access -------------------------------------------------------------
# When set, every /api route except /api/health needs a matching X-API-Key header.
# The web app sends it from its server. Set it in production.
ENGINE_API_KEY=
# Comma-separated browser origins allowed to call the engine. "*" allows all.
ENGINE_CORS_ORIGINS=*
# Serves the demo UI at "/". Set to 0 in production.
ENABLE_DEMO_UI=1

# --- AI models (OpenRouter) ---------------------------------------------
OPENROUTER_API_KEY=
LETTER_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash

# --- Email: sending (SMTP) and reading hospital replies (IMAP) ----------
# The advocate mailbox. Sends the letters and receives the hospital's replies.
ADVOCATE_EMAIL=advocate@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Autopilot ----------------------------------------------------------
# Seconds between follow-ups when the hospital is silent. 259200 = 72 hours.
CADENCE_SECONDS=259200
# How often the engine looks for follow-ups that are due.
AUTOPILOT_CHECK_SECONDS=60
# 1 = send nothing while any finding still needs review. 0 = send everything automatically.
AUTOPILOT_HOLD_FOR_REVIEW=0

# --- Fees (defaults; the web app can override the completion rate per case) ----
COMMITMENT_FEE=20
COMPLETION_FEE_RATE=0.10

# --- Storage -------------------------------------------------------------
# SQLite file and the folder for revised bill PDFs. Replace with the web app's own storage (see INTEGRATION.md).
ENGINE_DB_PATH=./engine.db
ENGINE_DATA_DIR=./data

# --- Optional ------------------------------------------------------------
# The sourced hospital contact directory. Defaults to engine/provider_directory.json.
PROVIDER_DIRECTORY_PATH=
# Server bind. In Docker the image sets these.
HOST=127.0.0.1
PORT=8000
RELOAD=1
# 1 = never send real email and never read the real inbox. Use in tests and local demos.
TESTING=0
